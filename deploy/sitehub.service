[Unit]
Description=SiteHub — dashboard of sites with admin panel
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=20

[Service]
Type=simple
User=sitehub
Group=sitehub
WorkingDirectory=/opt/sitehub
Environment=SITEHUB_DATA=/var/lib/sitehub
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sitehub/venv/bin/python -m sitehub.run
Restart=always
UMask=0027
RestartSec=2
# allow binding to ports < 1024 (80/443) without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
# Filesystem sandboxing (ProtectSystem etc.) is added by install.sh as a drop-in
# only where mount namespaces work - unprivileged LXC containers don't allow them.

[Install]
WantedBy=multi-user.target
