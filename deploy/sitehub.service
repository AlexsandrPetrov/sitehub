[Unit]
Description=SiteHub — dashboard of sites with admin panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sitehub
Group=sitehub
WorkingDirectory=/opt/sitehub
Environment=SITEHUB_DATA=/var/lib/sitehub
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/sitehub/venv/bin/python -m sitehub.run
Restart=always
RestartSec=1
# allow binding to ports < 1024 (80/443) without root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sitehub
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
